# ── Curb config ──────────────────────────────────────────────
# Copy this file to .env and fill in values as you set up each platform.
# You only need credentials for the platforms you actually connect.
# Never commit .env. Keep backups of it (see README) — losing APP_SECRET
# makes the stored tokens unreadable.

# Port and interface. Default binds to loopback only; put a reverse proxy
# with HTTPS (Caddy/nginx/Cloudflare Tunnel) in front. Only set HOST=0.0.0.0
# if you know why.
PORT=3000
HOST=127.0.0.1

# Set to the number of reverse proxies in front of Curb (usually 1) so
# login rate-limiting sees the real client IP. Leave empty when no proxy.
TRUST_PROXY=

# Public URL where THIS server is reachable from the internet. Must be https://
# unless it is localhost. Used for OAuth redirects and Instagram media fetches.
# Local dev: use a Cloudflare Tunnel or ngrok URL (see README).
# Production: your VPS domain, e.g. https://curb.yourdomain.com
PUBLIC_BASE_URL=http://localhost:3000

# REQUIRED. Random secret (32+ chars) that encrypts stored tokens and signs
# sessions. Curb refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# REQUIRED. The dashboard login (12+ characters). Use a long unique passphrase.
OWNER_PASSWORD=

# ── Meta / Instagram (Graph API) ─────────────────────────────
# developers.facebook.com -> create app -> Instagram Graph API / Facebook Pages
META_APP_ID=
META_APP_SECRET=

# ── TikTok (Content Posting API) ─────────────────────────────
# developers.tiktok.com -> create app -> add "Content Posting API" + "Login Kit"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Google / YouTube (Data API v3) ───────────────────────────
# console.cloud.google.com -> enable YouTube Data API v3 -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── X (API v2, OAuth 2.0) ────────────────────────────────────
# developer.x.com -> create project + app -> OAuth 2.0 settings
X_CLIENT_ID=
X_CLIENT_SECRET=
