# ── Curb config ──────────────────────────────────────────────
# Copy this file to .env and fill in values as you set up each platform.
# You only need credentials for the platforms you actually connect.

# Port the dashboard runs on
PORT=3000

# Public URL where THIS server is reachable from the internet.
# Required for OAuth redirects on all platforms, and Instagram
# additionally fetches your media files from this URL.
# Local dev: use a Cloudflare Tunnel or ngrok URL (see README).
# Production: your VPS domain, e.g. https://curb.yourdomain.com
PUBLIC_BASE_URL=http://localhost:3000

# Random secret used to encrypt stored access tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# ── Meta / Instagram (Graph API) ─────────────────────────────
# developers.facebook.com -> create app -> add "Instagram Graph API"
META_APP_ID=
META_APP_SECRET=

# ── TikTok (Content Posting API) ─────────────────────────────
# developers.tiktok.com -> create app -> add "Content Posting API" + "Login Kit"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Google / YouTube (Data API v3) ───────────────────────────
# console.cloud.google.com -> enable YouTube Data API v3 -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── X (API v2, OAuth 2.0) ────────────────────────────────────
# developer.x.com -> create project + app -> OAuth 2.0 settings
X_CLIENT_ID=
X_CLIENT_SECRET=
